# ==============================================================================
# Smart College Portal v2 - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and fill in your values. Never commit .env.

# Database Configuration (Local MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_portal
DB_USER=
DB_PASSWORD=

# Security & Secrets
# 32-byte Base64 key for AES-GCM encryption of sensitive data (e.g. Aadhaar, bank details)
AES_KEY=
# JWT Secret key (HMAC-SHA256, minimum 32 characters / 256 bits)
JWT_SECRET=
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Initial System Credentials & Default Passwords
DEFAULT_PASSWORD=ChangeMe@123
ADMIN_EMAIL=admin@college.local
ADMIN_PASSWORD=Admin@12345
SEND_PASSWORD_IN_EMAIL=false
TEMP_PASSWORD_MODE=default

# SMTP Email Configuration (Real SMTP for welcome emails, OTP, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@college.local

# Application URLs & CORS
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost

# Demo Data Generation (Set to true to generate rich sample records on first run)
SEED_DEMO_DATA=true
